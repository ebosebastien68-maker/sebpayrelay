# Copier ce fichier en .env sur le VPS, puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# --- Serveur ---
PORT=3000
# Délai maximal d'un appel sortant (SebPay, Supabase), en millisecondes
HTTP_TIMEOUT_MS=4000

# --- SebPay ---
# Live : https://newapi.sebpay.bj/api/v1
# Sandbox : serveur séparé, voir la documentation SebPay
SEBPAY_BASE_URL=
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
# URL publique du webhook de ce relais (https), envoyée à SebPay à chaque session
SEBPAY_CALLBACK_URL=https://sebpayrelay1.vps.webdock.cloud/webhook/sebpay

# --- Sécurité Supabase <-> relais ---
# Secret envoyé par Supabase dans l'en-tête x-relay-secret (long et aléatoire)
RELAY_SHARED_SECRET=
# Où le relais transmet les paiements confirmés, et le secret qu'il envoie
SUPABASE_WEBHOOK_URL=
SUPABASE_WEBHOOK_SECRET=
